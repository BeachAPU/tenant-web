# Application
# APP_SLUG must be unique per deployment when running multiple frontends
# from this same compose file (used for container name + Traefik routers).
APP_SLUG=tenant-web
APP_NAME=Tenant Web
APP_DOMAIN=tenant-web.local
# Optional second hostname this same instance also answers on, served
# against the customer's `demo` CustomerEnvironment instead of `live` (see
# TENANT_SLUG below - login/tenant-connection resolution now happens per
# request via an X-Tenant-Environment header, not this domain directly).
# Leave unset to only serve APP_DOMAIN against `live`, as before.
APP_DOMAIN_DEMO=demo.tenant-web.local
PORT=3003
NODE_ENV=dev

# API
API_KEY=changeme-demo-api-key

# Signs the admin session cookie (express-session) that keeps a logged-in
# user signed in — generate with `openssl rand -hex 32`, keep it secret, and
# never reuse across environments (rotating it logs everyone out).
SESSION_SECRET=changeme-generate-with-openssl-rand-hex-32
# How many minutes of inactivity before the session cookie expires.
SESSION_MAX_AGE_MINUTES=15

# Laravel API base URL. This app never talks to a database directly — all
# data (stats, login, etc.) goes through this API. Use the container name
# on the shared backend network (NOT the Traefik hosts-file domain,
# e.g. NOT http://hapi.local — that only resolves on the host, not from
# inside another container). Leave unset to use demo/mock data.
LARAVEL_API_URL=http://hapi:8080

# Historical: the login request still sends Host: `${TENANT_SLUG}.tenant.
# internal` to Laravel, but the API's tenant resolution is no longer
# Host-header-based (the old ResolveTenant middleware that read this was
# deleted) — login now looks a global_user up by email alone, and which of
# that customer's `live`/`demo` databases gets used is selected per request
# via the X-Tenant-Environment header (see APP_DOMAIN_DEMO above), not this
# value. Left in place since nothing on the API side rejects the header.
TENANT_SLUG=acme

# Traefik
TRAEFIK_NETWORK=backend
TRAEFIK_ENTRYPOINT=admin
TRAEFIK_CERT_RESOLVER=letsencrypt

# Production resource limits (docker-compose.yml)
CPU_LIMIT=1.0
MEMORY_LIMIT=512M
MEMORY_RESERVATION=128M

# Dev only (docker-compose.dev.yml) — host ports for the app/API and the
# Vite HMR dev server. VITE_PORT is the in-container Vite port (rarely
# needs changing since it's not published beyond DEV_VITE_PORT).
DEV_APP_PORT=3003
DEV_VITE_PORT=5183
VITE_PORT=5173
# Set to true only if file-change events don't fire on your host/filesystem
# (common with some VM/network-mounted setups).
CHOKIDAR_USEPOLLING=false
